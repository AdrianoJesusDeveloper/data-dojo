# Application
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ENVIRONMENT=development

# Django
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://dojo:dojo_dev_password@localhost:5432/dojo_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Frontend
# Origin of the Django server. Do not append /api.
VITE_API_URL=http://localhost:8000
VITE_DOJO_DASHBOARD_URL=https://dojo-dashboard-3ds.streamlit.app/

# Command Center
DOJO_APP_URL=https://data-dojo-nine.vercel.app/

# AI providers - configure only the providers you intend to use
AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_AI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Agents
AI_DEFAULT_PROVIDER=gemini
DDJ_AI_PROVIDER=gemini
AI_SALES_PROVIDER=gemini

# Security limits (production may use stricter values)
AI_ANON_THROTTLE_RATE=100/hour
AI_USER_THROTTLE_RATE=500/hour
SECURE_SSL_REDIRECT=False
# Change to mandatory only after SMTP has been validated end to end.
ACCOUNT_EMAIL_VERIFICATION=none

# Payments. Sandbox never performs a real charge. Production defaults to
# disabled until the Mercado Pago adapter and credentials are configured.
PAYMENT_BACKEND=sandbox

# GitHub Copilot / Copilot SDK compatible backend
COPILOT_API_URL=
COPILOT_API_TOKEN=
COPILOT_MODEL=gpt-5.4

# Email (used by password recovery)
EMAIL_HOST=smtp.example.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
DEFAULT_FROM_EMAIL=noreply@example.com
DJANGO_USE_SQLITE=True
ANTHROPIC_API_KEY=
ANTHROPIC_LIBRARY_MODEL=claude-sonnet-4-20250514
LIBRARY_EMBEDDING_MODEL=all-MiniLM-L6-v2
LIBRARY_MAX_UPLOAD_MB=50
DDJ_CONTENT_STUDIO_ENABLED=false
DDJ_CONTENT_STUDIO_LOCAL_ONLY=true
LOCAL_LIBRARY_PATH=C:\livros
CONTENT_STUDIO_PROVIDER=gemini
