# Application
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ENVIRONMENT=development

# Django
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://dojo:dojo_dev_password@localhost:5432/dojo_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Frontend
VITE_API_URL=http://localhost:8000/api

# AI providers - configure only the providers you intend to use
OPENAI_API_KEY=
OPENAI_AI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Agents
DDJ_AI_PROVIDER=chatgpt
AI_SALES_PROVIDER=chatgpt

# GitHub Copilot / Copilot SDK compatible backend
COPILOT_API_URL=
COPILOT_API_TOKEN=
COPILOT_MODEL=gpt-5.4

# Email (used by password recovery)
EMAIL_HOST=smtp.example.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
DEFAULT_FROM_EMAIL=noreply@example.com
