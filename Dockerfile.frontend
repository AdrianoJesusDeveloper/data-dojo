FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

# O index.html pertence ao modo SPA local (vite.local.config.ts).
# O build TanStack Start/Nitro deve gerar o documento SSR pelas rotas.
RUN rm -f index.html

ENV NITRO_PRESET=node-server

RUN npm run build

FROM node:22-alpine

WORKDIR /app

COPY --from=build /app/.output ./.output

ENV HOST=0.0.0.0
ENV PORT=80
ENV NODE_ENV=production

EXPOSE 80

CMD ["node", ".output/server/index.mjs"]
